# =================================================================
# Border Safety Alert System (BSAS) — Backend Environment Template
# =================================================================
# Copy to .env for local overrides. NEVER commit real production secrets!

# Environment mode: 'development' or 'production'
ENVIRONMENT=development

# MANDATORY in production: Cryptographically strong secret key (32+ characters).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In development only, an explicit fallback key is allowed with a warning.
SECRET_KEY=your-secure-production-secret-key-at-least-32-chars-long

# JWT token expiration in minutes (default 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# SQLite or PostgreSQL database connection string
DATABASE_URL=sqlite:///./bsas.db

# Optional Redis connection string (Phase 5+)
REDIS_URL=redis://localhost:6379

# Allowed CORS origins (comma-separated list for production)
# Example: https://dashboard.bsas.internal,https://ops.bsas.internal
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
